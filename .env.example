# Gemini нужен для AI-синтеза. Оставь пустым, если пока нужен только сбор данных.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Бесплатный режим: CoinGlass API выключен. Ключ не нужен.
COINGLASS_API_KEY=
ENABLE_COINGLASS_API=false

SYMBOL=BTCUSDT
LOCAL_TIMEZONE=Europe/Riga
TIMEOUT_SEC=6
ENABLE_COINGLASS_SCREENSHOT=true
ENABLE_RSS_NEWS=true
ENABLE_ETF_FLOWS=true
ENABLE_DERIBIT_OPTIONS=true
MANUAL_INPUT_DIR=manual_inputs
OUTPUT_REPORT_FILE=daily_report.md
HISTORY_FILE=market_history.json
SCREENSHOT_FILE=free_dashboard_screenshots/coinglass_heatmap.png
RAW_SNAPSHOT_FILE=market_snapshot.json
MAX_HISTORY_SNAPSHOTS=3000
HISTORY_LOOKBACK_HOURS=72
